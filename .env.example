# =====================================================================
# ExamPilot: Environment Variables Configuration Template
# =====================================================================
# Copy this file to '.env' and populate with your local values.
# NEVER commit the actual '.env' file to version control.

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=True
APP_NAME=ExamPilot
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars

# --- Server Configuration ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Database Configuration ---
# Default to local SQLite for zero-setup local development
DATABASE_URL=sqlite+aiosqlite:///./data/local/exampilot.db
# PostgreSQL alternative for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/exampilot

# --- AI Provider Configuration ---
# Provider options: "gemini", "mock" (for offline deterministic unit tests)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# --- Logging & Monitoring ---
LOG_LEVEL=INFO
